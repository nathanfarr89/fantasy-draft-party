{
  "name": "fantasy-draft-party",
  "version": "1.0.0",
  "description": "Jackbox-style fantasy draft party game",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "server": "node server/index.js"
  },
  "build": {
    "appId": "com.fantasydraft.party",
    "productName": "Fantasy Draft Party",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.53",
    "express": "^4.18.2",
    "ip": "^2.0.1",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "@flydotio/dockerfile": "^0.7.10",
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1"
  },
  "allowScripts": {
    "electron@28.3.3": true
  }
}

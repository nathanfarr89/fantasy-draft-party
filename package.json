{
  "name": "fantasy-draft-party",
  "version": "1.0.0",
  "description": "Jackbox-style fantasy draft party game",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "server": "node server/index.js",
    "build:steam": "electron-builder --win dir",
    "build:steam:mac": "electron-builder --mac dir"
  },
  "build": {
    "appId": "com.fantasydraft.party",
    "productName": "Fantasy Draft Party",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "files": [
      "main.js",
      "config.js",
      "host/**/*",
      "player/**/*",
      "server/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games"
    }
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.53",
    "express": "^4.18.2",
    "ip": "^2.0.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "@flydotio/dockerfile": "^0.7.10",
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1"
  },
  "allowScripts": {
    "electron@28.3.3": true
  }
}
